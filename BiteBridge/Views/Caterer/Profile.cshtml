@model BiteBridge.Models.Caterer

@{
    ViewData["Title"] = "Caterer Profile";
}

<div class="create-menu-page">
    <div class="create-menu-card">
        <h1>📍 Restaurant Location Profile</h1>
        <p>Update restaurant information and Google Maps location data.</p>

        <form asp-controller="Caterer" asp-action="Profile" method="post">
            <div class="form-group mb-3">
                <label>Business Name</label>
                <input name="businessName" class="form-control" value="@Model.BusinessName" required />
            </div>

            <div class="form-group mb-3">
                <label>Description</label>
                <textarea name="description" class="form-control">@Model.Description</textarea>
            </div>

            <div class="form-group mb-3">
                <label>Address</label>
                <input name="address" class="form-control" value="@Model.Address" placeholder="Example: Ankara, Çankaya" required />
            </div>

            <div class="form-group mb-3">
                <label>Latitude</label>
                <input name="latitude" type="number" step="0.000001" class="form-control" value="@Model.Latitude" required />
            </div>

            <div class="form-group mb-3">
                <label>Longitude</label>
                <input name="longitude" type="number" step="0.000001" class="form-control" value="@Model.Longitude" required />
            </div>

            <div class="location-help-box">
                <p>
                    You can find latitude and longitude by opening Google Maps, right clicking the location,
                    and copying the coordinates.
                </p>
            </div>

            <button type="submit" class="auth-btn">
                Save Location
            </button>

            <a class="dashboard-btn secondary" asp-controller="Caterer" asp-action="Index">
                Back to Dashboard
            </a>
        </form>
    </div>
</div>
@{
    ViewData["Title"] = "Caterer Dashboard";
}

<div class="dashboard-page">
    <h1>👨‍🍳 Caterer Dashboard</h1>
    <p class="dashboard-subtitle">Restaurant and menu management summary.</p>

    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>Total Menu Items</h3>
            <p>@ViewBag.TotalMenuItems</p>
        </div>

        <div class="dashboard-card">
            <h3>Total Received Orders</h3>
            <p>@ViewBag.TotalOrders</p>
        </div>

        <div class="dashboard-card">
            <h3>Revenue Simulation</h3>
            <p>@ViewBag.RevenueSimulation TL</p>
        </div>
    </div>

    <div class="dashboard-section">
        <h2>Caterer Actions</h2>
        <p>Create menu items, upload images, and define dynamic customization options.</p>

        <a class="dashboard-btn" asp-controller="Caterer" asp-action="CreateMenuItem">
        Create Menu Item
        </a>

        <a class="dashboard-btn secondary" asp-controller="Caterer" asp-action="MenuItems">
        Manage My Menu
        </a>

        <a class="dashboard-btn secondary" asp-controller="Home" asp-action="Index">
         View Public Menu
        </a>

        <a class="dashboard-btn secondary" asp-controller="Caterer" asp-action="Profile">
        Edit Restaurant Location
        </a>
    </div>
</div>

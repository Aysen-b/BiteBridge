@{
    ViewData["Title"] = "Caterer Dashboard";
}

<div class="dashboard-page">
    <h1>👨‍🍳 Caterer Dashboard</h1>
    <p class="dashboard-subtitle">Restaurant and order activity summary.</p>

    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>Total Received Orders</h3>
            <p>@ViewBag.TotalOrders</p>
        </div>

        <div class="dashboard-card">
            <h3>Completed Orders</h3>
            <p>@ViewBag.CompletedOrders</p>
        </div>

        <div class="dashboard-card">
            <h3>Revenue Simulation</h3>
            <p>@ViewBag.RevenueSimulation TL</p>
        </div>
    </div>

    <div class="dashboard-section">
        <h2>Caterer Actions</h2>
        <p>This dashboard represents the caterer side of the BiteBridge role-based system.</p>
        <a class="dashboard-btn" asp-controller="Home" asp-action="Index">View Menu Page</a>
    </div>
</div>

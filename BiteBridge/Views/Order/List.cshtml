@model IEnumerable<BiteBridge.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<div class="orders-page">
    <h1>🍔 My Orders</h1>

    @if (!Model.Any())
    {
        <div class="order-card">
            <p>No orders found.</p>
        </div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <div class="order-card">
                <p><strong>Order No:</strong> BB-@order.Id</p>
                <p><strong>User:</strong> @order.UserEmail</p>

                <h3>Total: @order.TotalPrice TL</h3>

                <div class="order-actions">
                    <a class="receipt-btn" asp-controller="Order" asp-action="Receipt" asp-route-id="@order.Id">
                        View Receipt
                    </a>

                    <a class="receipt-btn" asp-controller="Order" asp-action="ReceiptPdf" asp-route-id="@order.Id">
                        Receipt PDF
                    </a>

                    <a class="agreement-btn" asp-controller="Order" asp-action="AgreementPdf" asp-route-id="@order.Id">
                        Agreement PDF
                    </a>

                    <a class="delete-btn" asp-controller="Order" asp-action="Delete" asp-route-id="@order.Id">
                        Delete
                    </a>
                </div>

                <p><strong>Items:</strong></p>

                <ul>
                    @foreach (var item in order.ItemsList)
                    {
                        <li>@item.name x 1 → @item.price TL</li>
                    }
                </ul>
            </div>
        }
    }
</div>
@{
    ViewData["Title"] = "Home Page";
}

<div class="home-hero">
    <h1>🍔 BiteBridge</h1>
    <p>Fresh food, fast order, easy checkout.</p>
</div>

<div class="menu">
    <div class="menu-card">
        <h3>🍔 Burger</h3>
        <p class="price">120 TL</p>
        <button onclick="addToCart({ name: 'Burger', price: 120 })">
            Add to Cart
        </button>
    </div>
</div>
<div class="cart-box">
    <h3>🛒 Cart</h3>

    <div id="cart-items"></div>
    <p id="total-price"></p>

    <button class="clear-btn" onclick="clearCart(); displayCart();">
        Clear Cart
    </button>

    <button class="checkout-btn" onclick="checkout();">
        Checkout
    </button>
</div>

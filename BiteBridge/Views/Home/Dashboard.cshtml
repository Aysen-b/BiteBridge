@{
    ViewData["Title"] = "User Dashboard";
    var recentOrders = ViewBag.RecentOrders as List<BiteBridge.Models.Order>;
}

<div class="dashboard-page">
    <h1>👤 User Dashboard</h1>
    <p class="dashboard-subtitle">Your BiteBridge activity summary.</p>

    <div class="dashboard-grid">
        <div class="dashboard-card">
            <h3>Total Orders</h3>
            <p>@ViewBag.TotalOrders</p>
        </div>

        <div class="dashboard-card">
            <h3>Total Spent</h3>
            <p>@ViewBag.TotalSpent TL</p>
        </div>

        <div class="dashboard-card">
            <h3>Recent Activity</h3>
            <p>Latest orders are listed below.</p>
        </div>
    </div>

    <div class="dashboard-section">
        <h2>Recent Orders</h2>

        @if (recentOrders == null || !recentOrders.Any())
        {
            <p>No recent orders found.</p>
        }
        else
        {
            <ul>
                @foreach (var order in recentOrders)
                {
                    <li>Order BB-@order.Id → @order.TotalPrice TL</li>
                }
            </ul>
        }

        <a class="dashboard-btn" asp-controller="Order" asp-action="List">View My Orders</a>
        <a class="dashboard-btn secondary" asp-controller="Home" asp-action="Index">Go to Menu</a>
    </div>
</div>